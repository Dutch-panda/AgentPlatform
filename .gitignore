# Local credentials and environments
.env
.env.*
!.env.example
.venv/
venv/

# Python caches and build output
__pycache__/
*.py[cod]
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
.vscode/
htmlcov/
build/
dist/
*.egg-info/

# Generated graph data
.graphify/
graphify-out/

# Local system files
.DS_Store
*.log

# Workspace code execution outputs
workspace/*
!workspace/.gitkeep

# Graphify build artifacts
vault/.graphify/

# Ignore generated markdown content in the vault, but keep the folders
vault/tasks/*.md
vault/research/*.md
vault/specs/*.md
vault/code-reviews/*.md
!vault/README.md
!vault/**/.gitkeep
